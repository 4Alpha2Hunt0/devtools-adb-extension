# Copy this file to .env and fill in real values. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Absolute path to the Obsidian Brain vault on your machine
VAULT_PATH=/absolute/path/to/obsidian-brain/vault

# Folder (inside the vault) to watch for dropped files
INBOX_DIR=Inbox

# Folder (inside the vault) where original dropped files get archived
ATTACHMENTS_DIR=Attachments

# Claude model used to summarize/classify dropped files
MODEL=claude-sonnet-5
